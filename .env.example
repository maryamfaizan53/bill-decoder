# Model configuration (only these models are allowed: claude-haiku-4-5,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite, gpt-4.1-mini, gpt-5-mini)
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-haiku-4-5
API_KEY=your-api-key-here

# Optional tuning (defaults shown)
EXTRACT_RUNS=3
CONCURRENCY=2
MAX_IMAGE_EDGE=1568
CACHE_DIR=.cache
